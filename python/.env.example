# LLM Provider (优先级从上到下，首个可用者生效)
VALOR_LLM_PROVIDER=openai_compat

# OpenAI Compatible (DeepSeek/Qwen/Kimi/OpenRouter/智谱等)
VALOR_OPENAI_API_KEY=
VALOR_OPENAI_BASE_URL=https://api.deepseek.com/v1
VALOR_OPENAI_MODEL=deepseek-chat

# Google Gemini
VALOR_GEMINI_API_KEY=
VALOR_GEMINI_MODEL=gemini-1.5-flash

# Ollama (本地)
VALOR_OLLAMA_BASE_URL=http://localhost:11434
VALOR_OLLAMA_MODEL=qwen2.5:7b

# Tushare (补数据源用)
TUSHARE_TOKEN=

# Baostock (免登录)
# 无需配置

# AkShare 代理（可选，参考 A_Share 项目）
AKSHARE_PROXY_LIST=direct
AKSHARE_PROXY_MAX_ATTEMPTS=3
AKSHARE_PROXY_BASE_DELAY=1
AKSHARE_PROXY_MAX_DELAY=15
AKSHARE_PROXY_JITTER=0.5
AKSHARE_PROXY_ALLOW_DIRECT=true

# 数据缓存
VALOR_CACHE_DIR=.cache

# ===== Knowledge Base =====
VALOR_KB_ENABLED=true
VALOR_KB_FILES_DIR=data/kb_files
VALOR_KB_MODELS_DIR=
VALOR_KB_EMBED_MODEL=BAAI/bge-small-zh-v1.5
VALOR_KB_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
VALOR_KB_SIMILARITY_THRESHOLD=0.30
VALOR_KB_TOP_K=5
VALOR_KB_BM25_K=30
VALOR_KB_VEC_K=30
VALOR_KB_RRF_K=10
# Agentic RAG 开关 (默认 ON, 设 0 关闭做 A/B 对比)
VALOR_KB_QUERY_REWRITE=1
VALOR_KB_MULTI_QUERY=1
VALOR_KB_MULTI_QUERY_N=3
# 加权 RRF (BM25 vs 向量; 默认偏向向量 0.3:0.7; 等权改 0.5:0.5)
VALOR_KB_RRF_W_BM25=0.3
VALOR_KB_RRF_W_VEC=0.7
VALOR_KB_VINTAGE_RESEARCH_MONTHS=6
VALOR_KB_VINTAGE_DISCLOSURE_MONTHS=18
VALOR_KB_VINTAGE_GENERAL_MONTHS=24
VALOR_KB_VINTAGE_REGULATORY_MONTHS=36
VALOR_KB_CORRECTION_TOLERANCE=0.01
